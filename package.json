{
  "name": "moemoe",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "postbuild": "node scripts/write-dist-env.mjs production",
    "lint": "biome lint --max-diagnostics=none --diagnostic-level=info",
    "check": "biome check --max-diagnostics=none --diagnostic-level=info",
    "test": "vitest run",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^26.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
