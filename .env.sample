# Optional. Leave blank unless you control and trust the proxy.
VITE_FIX_CORS_API_URL=

# Optional. Leave blank to use the deployment server's HTTP Date header.
# External APIs may use a {timezone} placeholder or a timeZone/timezone/tz query parameter.
VITE_SERVER_TIME_API_URL=

VITE_GITHUB_REPO_URL=https://github.com/gaon12/MoeMoe

# Optional HTTPS endpoint. Built-in quotes are used if it is unavailable.
VITE_ANIME_QUOTE_API_URL=https://yurippe.vercel.app/api/quotes?random=1
VITE_IP_REVERSE_GEOCODING_API_URL=https://ipinfo.io

# Optional. Build commit for the update check. Read from git when empty.
VITE_APP_COMMIT=
