{
  "name": "MoeMoe",
  "short_name": "MoeMoe",
  "description": "An animated wallpaper clock inspired by the Windows lock screen.",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#1a1a1a",
